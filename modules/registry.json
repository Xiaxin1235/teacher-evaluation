  "work_rule": {
    "one_agent_per_step": "当前对话的内存上限决定一个 agent 不用'一次写完整个项目'，而是每一步只认领一个 module id，读该 module 的 SPEC.md，交付 produce 清单并跑通 verify",
    "no_hallucination": "agent 只能在 SPEC 中声明的粒度内工作，任何超出 SPEC 的假设必须先写回 SPEC 再执行",
    "acceptance_gate": "每个 module 交付后先跑 verify（本地命令，不需要真实数据或 API key），跑通才允许标记 done",
    "next_step_query": "每条对话先跑 scripts/module_board.py，寻找 status=todo 且依赖全 done 的模块作为下一步"
  }
}